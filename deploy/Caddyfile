# Caddy gets and renews the HTTPS certificate for DOMAIN automatically
# (the domain's DNS must point to this server, and ports 80 and 443 must be open).
{$DOMAIN} {
	encode gzip
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output stdout
		format console
	}
}
