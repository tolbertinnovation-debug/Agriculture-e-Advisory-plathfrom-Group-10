# AgriConnect server settings. Copy to .env and fill in. NEVER commit .env to GitHub.
# Full explanations: docs/deploy.md and docs/dev-setup.md

# ---- Web address (Caddy gets the HTTPS certificate for it) ----
DOMAIN=agriconnect.example.org

# ---- Database (PostgreSQL runs in Docker next to the app) ----
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-24   # letters and digits only (it goes into a URL)

# ---- Staff security ----
REQUIRE_2FA=1                 # every staff member must use 2-step login
# STAFF_AUTH=off              # never on a real server (the server refuses to start)

# ---- SMS / USSD provider ----
SMS_PROVIDER=log              # log = not sent to phones. Use africastalking or http when ready.
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
WEBHOOK_SECRET=change-me-to-a-long-random-string   # gateway URLs end in ?secret=<this>
SMS_CONCURRENCY=10            # SMS handed to the provider at the same time (ask the provider for its limit)

# ---- Pilot ----
PILOT_COUNTIES=Bong,Nimba     # npm run preflight checks these counties have officers

# ---- Jobs (Liberia time = UTC) ----
ADVICE_HOUR=7
BACKUP_HOUR=2
BACKUP_KEEP=14
# SCHEDULER=off               # stop the daily crop advice
# WEATHER=off                 # stop fetching forecasts

# ---- Alerts ----
# ERROR_WEBHOOK_URL=          # Slack / Discord / Teams incoming webhook for server errors

# ---- Only if another website must call the API ----
# CORS_ORIGINS=https://partner.example.org
